<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="libs\**" />
    <Compile Remove="Modules\ColorCatalogEntry\CoreColors\**" />
    <EmbeddedResource Remove="libs\**" />
    <EmbeddedResource Remove="Modules\ColorCatalogEntry\CoreColors\**" />
    <None Remove="libs\**" />
    <None Remove="Modules\ColorCatalogEntry\CoreColors\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Modules\ColorCatalogEntry\ColorCatalogEntryBase.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="bransitems_assets" />
    <None Remove="bransitems_assets.manifest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="bransitems_assets" />
    <EmbeddedResource Include="bransitems_assets.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
    <PackageReference Include="R2API.Colors" Version="1.0.3" />
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.Elites" Version="1.1.3" />
    <PackageReference Include="R2API.Items" Version="1.0.8" />
    <PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.RecalculateStats" Version="1.7.0" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="RoR2BepInExPack" Version="1.48.0" />
    <PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.6" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
  </ItemGroup>

  <!-- Soft dependencies. Never copied to the output; only loaded at runtime when the other mod is installed. -->
  <ItemGroup>
    <Reference Include="BiggerBazaar">
      <HintPath>libs\BiggerBazaar.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LookingGlass">
      <HintPath>libs\LookingGlass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProperSave">
      <HintPath>libs\ProperSave.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Refightilization">
      <HintPath>libs\Refightilization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ShareSuite">
      <HintPath>libs\ShareSuite.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ReadmeAssets\Items\" />
  </ItemGroup>

</Project>
